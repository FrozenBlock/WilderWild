{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Overhauls the Wild Update, adding features and improving existing ones.",
  "authors": [
    "Lunade/AViewFromTheTop",
    "Ethan Stokes",
    "Soro"
  ],
  "contributors": [
    "zhen",
    "voxelotl",
    "pictochats_",
    "Rebel459",
    "Lufurrius",
    "magistermaks",
    "SaishoVibes",
    "zozozrob_",
    "Osmiooo",
    "Xfrtrex",
    "Enri"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${source_url}",
    "issues": "${issues_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/wilderwild/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.frozenblock.wilderwild.WilderWildFabric"
    ],
    "client": [
      "net.frozenblock.wilderwild.WilderWildFabricClient"
    ],
    "modmenu": [
      "net.frozenblock.wilderwild.config.gui.WilderWildModMenuIntegration"
    ],
    "terrablender": [
      "net.frozenblock.wilderwild.mod_compat.WWTerraBlenderEntrypoint"
    ],
    "fabric-datagen": [
      "net.frozenblock.wilderwild.data.WWDataGenerator"
    ]
  },
  "mixins": [
    "wilderwild.mixins.json",
    "wilderwild.fabric.mixins.json"
  ],
  "accessWidener": "wilderwild.classtweaker",
  "depends": {
    "frozenlib": "${frozenlib_version}",
    "fabricloader": "${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "cloth-config": "*",
    "terrablender": "*",
    "biolith": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "X": "https://x.com/FB_Oasis",
        "Bluesky": "https://bsky.app/profile/frozenblock.bsky.social",
        "modmenu.discord": "https://discord.gg/frozenblock",
        "modmenu.modrinth": "https://modrinth.com/organization/frozenblock",
        "modmenu.youtube": "https://www.youtube.com/@frozenblockmoddingoasismod",
        "modmenu.kofi": "https://ko-fi.com/frozenblock"
      },
      "badges": [
        "frozenblock"
      ]
    },
    "frozenlib_registry": {
      "mod_protocol": $protocol_version
    },
    "lithium:options": {
      "mixin.world.raycast": false
    }
  }
}
