{
  "dimensions": "#frozenlib:overworld",
  "rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "frozenlib:config_predicate",
        "config_predicate": {
          "type": "frozenlib:equal_to",
          "entry": "wilderwild:worldgen/aquaticGeneration/oceanMossGeneration",
          "target": true
        }
      },
      "then_run": {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "#wilderwild:feature/aquatic/ocean_moss"
        },
        "then_run": {
          "type": "minecraft:condition",
          "if_true": "minecraft:on_floor",
          "then_run": {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:not",
              "invert": "minecraft:not_underwater"
            },
            "then_run": {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:noise_threshold",
                "max_threshold": -0.25,
                "min_threshold": -0.65,
                "noise": "wilderwild:ocean_moss"
              },
              "then_run": {
                "type": "minecraft:block",
                "result_state": "minecraft:moss_block"
              }
            }
          }
        }
      }
    }
  }
}