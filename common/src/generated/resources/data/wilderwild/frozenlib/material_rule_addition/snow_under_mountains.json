{
  "dimensions": "#frozenlib:overworld",
  "rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "frozenlib:config_predicate",
      "config_predicate": {
        "type": "frozenlib:equal_to",
        "entry": "wilderwild:worldgen/snowUnderMountains",
        "target": true
      }
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:biome",
        "biome_is": "#wilderwild:below_surface_snow"
      },
      "then_run": {
        "type": "minecraft:condition",
        "if_true": "minecraft:on_floor",
        "then_run": {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:not",
            "invert": {
              "type": "minecraft:vertical_gradient",
              "false_at_and_above": {
                "absolute": 72
              },
              "random_name": "minecraft:snow_gradient",
              "true_at_and_below": {
                "absolute": 64
              }
            }
          },
          "then_run": {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:water",
              "add_stone_depth": false,
              "offset": 0,
              "surface_depth_multiplier": 0
            },
            "then_run": {
              "type": "minecraft:block",
              "result_state": "minecraft:snow_block"
            }
          }
        }
      }
    }
  }
}