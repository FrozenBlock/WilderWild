{
  "dimensions": "#frozenlib:overworld",
  "rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:biome",
        "biome_is": "wilderwild:tundra"
      },
      "then_run": {
        "type": "minecraft:condition",
        "if_true": "minecraft:on_floor",
        "then_run": {
          "type": "minecraft:condition",
          "if_true": "minecraft:not_underwater",
          "then_run": {
            "type": "minecraft:sequence",
            "sequence": [
              {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "minecraft:noise_threshold",
                  "max_threshold": 1.7976931348623157E308,
                  "min_threshold": 0.85,
                  "noise": "wilderwild:tundra_patch_selector"
                },
                "then_run": {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:noise_threshold",
                    "max_threshold": 1.7976931348623157E308,
                    "min_threshold": 0.35,
                    "noise": "wilderwild:tundra_patch"
                  },
                  "then_run": {
                    "type": "minecraft:block",
                    "result_state": "minecraft:coarse_dirt"
                  }
                }
              },
              {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "minecraft:noise_threshold",
                  "max_threshold": 1.7976931348623157E308,
                  "min_threshold": 0.35,
                  "noise": "wilderwild:tundra_patch"
                },
                "then_run": {
                  "type": "minecraft:sequence",
                  "sequence": [
                    {
                      "type": "minecraft:condition",
                      "if_true": {
                        "type": "minecraft:noise_threshold",
                        "max_threshold": 1.7976931348623157E308,
                        "min_threshold": 0.85,
                        "noise": "wilderwild:tundra_patch"
                      },
                      "then_run": {
                        "type": "minecraft:block",
                        "result_state": "minecraft:rooted_dirt"
                      }
                    },
                    {
                      "type": "minecraft:block",
                      "result_state": "minecraft:coarse_dirt"
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}