{
  "dimensions": "#frozenlib:overworld",
  "rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "frozenlib:config_predicate",
        "config_predicate": {
          "type": "frozenlib:equal_to",
          "entry": "wilderwild:worldgen/betaBeaches",
          "target": true
        }
      },
      "then_run": {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": "#wilderwild:material_rule/gravel"
            },
            "then_run": {
              "type": "minecraft:condition",
              "if_true": "minecraft:under_floor",
              "then_run": {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "minecraft:y_above",
                  "add_stone_depth": true,
                  "anchor": {
                    "absolute": 58
                  },
                  "surface_depth_multiplier": 0
                },
                "then_run": {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:not",
                    "invert": {
                      "type": "minecraft:y_above",
                      "add_stone_depth": true,
                      "anchor": {
                        "absolute": 65
                      },
                      "surface_depth_multiplier": 0
                    }
                  },
                  "then_run": {
                    "type": "minecraft:condition",
                    "if_true": {
                      "type": "minecraft:noise_threshold",
                      "max_threshold": -0.12,
                      "min_threshold": -1.7976931348623157E308,
                      "noise": "wilderwild:gravel_beach"
                    },
                    "then_run": "wilderwild:gravel_and_stone_beta_beach"
                  }
                }
              }
            }
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": "#wilderwild:material_rule/sand"
            },
            "then_run": {
              "type": "minecraft:condition",
              "if_true": "minecraft:under_floor",
              "then_run": {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "minecraft:y_above",
                  "add_stone_depth": true,
                  "anchor": {
                    "absolute": 58
                  },
                  "surface_depth_multiplier": 0
                },
                "then_run": {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:not",
                    "invert": {
                      "type": "minecraft:y_above",
                      "add_stone_depth": true,
                      "anchor": {
                        "absolute": 65
                      },
                      "surface_depth_multiplier": 0
                    }
                  },
                  "then_run": {
                    "type": "minecraft:condition",
                    "if_true": {
                      "type": "minecraft:noise_threshold",
                      "max_threshold": 1.7976931348623157E308,
                      "min_threshold": 0.12,
                      "noise": "wilderwild:sand_beach"
                    },
                    "then_run": "wilderwild:sand_and_sandstone_beta_beach"
                  }
                }
              }
            }
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": "#wilderwild:material_rule/beta_beach_sand_deep"
            },
            "then_run": {
              "type": "minecraft:condition",
              "if_true": "minecraft:deep_under_floor",
              "then_run": {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "minecraft:y_above",
                  "add_stone_depth": true,
                  "anchor": {
                    "absolute": 58
                  },
                  "surface_depth_multiplier": 0
                },
                "then_run": {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:not",
                    "invert": {
                      "type": "minecraft:y_above",
                      "add_stone_depth": true,
                      "anchor": {
                        "absolute": 64
                      },
                      "surface_depth_multiplier": 0
                    }
                  },
                  "then_run": {
                    "type": "minecraft:condition",
                    "if_true": {
                      "type": "minecraft:noise_threshold",
                      "max_threshold": 1.7976931348623157E308,
                      "min_threshold": 0.12,
                      "noise": "wilderwild:sand_beach"
                    },
                    "then_run": "wilderwild:sand_and_sandstone_beta_beach"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}