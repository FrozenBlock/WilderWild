{
  "dimensions": "#frozenlib:overworld",
  "rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "frozenlib:config_predicate",
        "config_predicate": "wilderwild:generate_coarse_dirt"
      },
      "then_run": {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "#wilderwild:material_rule/coarse_dirt_path"
        },
        "then_run": "wilderwild:coarse_dirt_path"
      }
    }
  }
}