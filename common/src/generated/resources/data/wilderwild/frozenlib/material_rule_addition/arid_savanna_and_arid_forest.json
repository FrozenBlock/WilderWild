{
  "dimensions": "#frozenlib:overworld",
  "rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:biome",
        "biome_is": [
          "wilderwild:arid_savanna",
          "wilderwild:arid_forest"
        ]
      },
      "then_run": {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:noise_threshold",
              "max_threshold": 0.3666,
              "min_threshold": 0.155,
              "noise": "minecraft:surface"
            },
            "then_run": {
              "type": "minecraft:sequence",
              "sequence": [
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "frozenlib:config_predicate",
                    "config_predicate": "wilderwild:generate_coarse_dirt"
                  },
                  "then_run": "wilderwild:coarse_dirt_path"
                },
                "wilderwild:grass_and_dirt"
              ]
            }
          },
          "wilderwild:sand_and_very_deep_sandstone"
        ]
      }
    }
  }
}