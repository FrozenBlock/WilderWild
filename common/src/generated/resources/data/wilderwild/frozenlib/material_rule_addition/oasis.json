{
  "dimensions": "#frozenlib:overworld",
  "rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:biome",
        "biome_is": "wilderwild:oasis"
      },
      "then_run": {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:noise_threshold",
              "max_threshold": -0.66,
              "min_threshold": -2.0,
              "noise": "wilderwild:oasis_grass"
            },
            "then_run": "wilderwild:grass_and_dirt"
          },
          "wilderwild:sand_and_very_deep_sandstone"
        ]
      }
    }
  }
}