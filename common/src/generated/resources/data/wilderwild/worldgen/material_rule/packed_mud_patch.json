{
  "type": "minecraft:condition",
  "if_true": "minecraft:on_floor",
  "then_run": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:noise_threshold",
      "max_threshold": 0.0,
      "min_threshold": -0.5,
      "noise": "wilderwild:packed_mud_patch_selector"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:noise_threshold",
        "max_threshold": 1.7976931348623157E308,
        "min_threshold": 1.15,
        "noise": "wilderwild:packed_mud_patch"
      },
      "then_run": {
        "type": "minecraft:condition",
        "if_true": "minecraft:not_underwater",
        "then_run": {
          "type": "minecraft:block",
          "result_state": "minecraft:packed_mud"
        }
      }
    }
  }
}