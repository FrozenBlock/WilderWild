{
  "type": "minecraft:condition",
  "if_true": "minecraft:on_floor",
  "then_run": {
    "type": "minecraft:condition",
    "if_true": "minecraft:not_underwater",
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:noise_threshold",
        "max_threshold": 0.55,
        "min_threshold": 0.26,
        "noise": "wilderwild:coarse_dirt_path"
      },
      "then_run": {
        "type": "minecraft:block",
        "result_state": "minecraft:coarse_dirt"
      }
    }
  }
}