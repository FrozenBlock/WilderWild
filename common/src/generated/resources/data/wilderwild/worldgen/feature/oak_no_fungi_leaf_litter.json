{
  "type": "minecraft:tree",
  "below_trunk_provider": {
    "type": "minecraft:rule_based_state_provider",
    "rules": [
      {
        "if_true": {
          "type": "minecraft:not",
          "predicate": {
            "type": "minecraft:matching_block_tag",
            "tag": "minecraft:cannot_replace_below_tree_trunk"
          }
        },
        "then": {
          "type": "minecraft:simple_state_provider",
          "state": "minecraft:dirt"
        }
      }
    ]
  },
  "decorators": [
    {
      "type": "minecraft:place_on_ground",
      "block_state_provider": {
        "type": "frozenlib:leaf_litter_provider",
        "block": "minecraft:leaf_litter",
        "max_segment": 3
      },
      "height": 2,
      "radius": 4,
      "tries": 96
    },
    {
      "type": "minecraft:place_on_ground",
      "block_state_provider": {
        "type": "frozenlib:leaf_litter_provider",
        "block": "minecraft:leaf_litter"
      },
      "height": 2,
      "tries": 150
    }
  ],
  "foliage_placer": {
    "type": "minecraft:blob_foliage_placer",
    "height": 3,
    "offset": 0,
    "radius": 2
  },
  "foliage_provider": {
    "type": "minecraft:simple_state_provider",
    "state": "minecraft:oak_leaves"
  },
  "ignore_vines": true,
  "minimum_size": {
    "type": "minecraft:two_layers_feature_size"
  },
  "trunk_placer": {
    "type": "wilderwild:straight_with_branches_trunk_placer",
    "base_height": 6,
    "branch_placement": {
      "cutoff_from_top": {
        "type": "minecraft:uniform",
        "max_inclusive": 3,
        "min_inclusive": 1
      },
      "length": 1,
      "max_count": {
        "type": "minecraft:uniform",
        "max_inclusive": 2,
        "min_inclusive": 1
      },
      "probability": 0.1
    },
    "height_rand_a": 2,
    "height_rand_b": 1
  },
  "trunk_provider": {
    "type": "minecraft:simple_state_provider",
    "state": "minecraft:oak_log"
  }
}