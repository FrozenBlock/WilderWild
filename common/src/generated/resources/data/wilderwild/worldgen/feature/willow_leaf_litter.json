{
  "type": "minecraft:tree",
  "below_trunk_provider": {
    "type": "minecraft:rule_based_state_provider",
    "rules": [
      {
        "if_true": {
          "type": "minecraft:not",
          "predicate": {
            "type": "minecraft:matching_block_tag",
            "tag": "wilderwild:cannot_replace_below_tree_trunk_waterloggable"
          }
        },
        "then": {
          "type": "minecraft:simple_state_provider",
          "state": "minecraft:dirt"
        }
      }
    ]
  },
  "decorators": [
    {
      "type": "minecraft:leave_vine",
      "probability": 0.125
    },
    {
      "type": "frozenlib:probability",
      "decorator": {
        "type": "frozenlib:config_predicate",
        "decorator": {
          "type": "minecraft:shelf_mushroom",
          "probability": 0.25
        },
        "predicate": {
          "type": "frozenlib:equal_to",
          "entry": "wilderwild:worldgen/treeGeneration/willowShelfMushroom",
          "target": true
        }
      },
      "probability": 0.09
    },
    {
      "type": "minecraft:place_on_ground",
      "block_state_provider": {
        "type": "frozenlib:leaf_litter_provider",
        "block": "wilderwild:willow_leaf_litter",
        "max_segment": 3
      },
      "height": 2,
      "radius": 4,
      "tries": 96
    },
    {
      "type": "minecraft:place_on_ground",
      "block_state_provider": {
        "type": "frozenlib:leaf_litter_provider",
        "block": "wilderwild:willow_leaf_litter"
      },
      "height": 2,
      "tries": 150
    }
  ],
  "foliage_placer": {
    "type": "wilderwild:willow_foliage_placer",
    "hanging_leaves_chance": 0.5,
    "hanging_leaves_extension_chance": 0.5,
    "height": 2,
    "offset": 1,
    "radius": 3
  },
  "foliage_provider": {
    "type": "minecraft:simple_state_provider",
    "state": "wilderwild:willow_leaves"
  },
  "ignore_vines": true,
  "minimum_size": {
    "type": "minecraft:two_layers_feature_size",
    "limit": 2,
    "upper_size": 2
  },
  "root_placer": {
    "type": "wilderwild:willow_root_placer",
    "above_root_placement": {
      "above_root_placement_chance": 0.45,
      "above_root_provider": {
        "type": "minecraft:simple_state_provider",
        "state": "minecraft:moss_carpet"
      }
    },
    "root_provider": {
      "type": "minecraft:simple_state_provider",
      "state": "wilderwild:willow_log"
    },
    "trunk_offset_y": {
      "type": "minecraft:uniform",
      "max_inclusive": 1,
      "min_inclusive": 1
    },
    "willow_root_placement": {
      "can_grow_through": "#wilderwild:willow_roots_can_grow_through",
      "max_root_length": 5,
      "max_root_width": 3,
      "random_skew_chance": 0.2
    }
  },
  "trunk_placer": {
    "type": "wilderwild:willow_trunk_placer",
    "base_height": 5,
    "branch_split_gap_chance": 0.35,
    "height_rand_a": 2,
    "height_rand_b": 1,
    "trunk_branch_placement": {
      "branch_length": {
        "type": "minecraft:uniform",
        "max_inclusive": 3,
        "min_inclusive": 2
      },
      "branch_placement_chance": 0.5,
      "foliage_placement_chance": 1.0,
      "foliage_radius_offset": -1,
      "offset_last_log_chance": 1.0
    },
    "trunk_split_height": {
      "type": "minecraft:uniform",
      "max_inclusive": 5,
      "min_inclusive": 2
    }
  },
  "trunk_provider": {
    "type": "minecraft:simple_state_provider",
    "state": "wilderwild:willow_log"
  }
}