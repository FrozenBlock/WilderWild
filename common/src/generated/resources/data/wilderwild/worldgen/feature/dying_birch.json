{
  "type": "minecraft:tree",
  "below_trunk_provider": {
    "type": "minecraft:rule_based_state_provider",
    "rules": [
      {
        "if_true": {
          "type": "minecraft:not",
          "predicate": {
            "type": "minecraft:matching_block_tag",
            "tag": "minecraft:cannot_replace_below_tree_trunk"
          }
        },
        "then": {
          "type": "minecraft:simple_state_provider",
          "state": "minecraft:dirt"
        }
      }
    ]
  },
  "decorators": [
    {
      "type": "minecraft:beehive",
      "probability": 0.004
    },
    {
      "type": "frozenlib:probability",
      "decorator": {
        "type": "frozenlib:config_predicate",
        "decorator": {
          "type": "minecraft:shelf_mushroom",
          "probability": 0.25
        },
        "predicate": {
          "type": "frozenlib:equal_to",
          "entry": "wilderwild:worldgen/treeGeneration/birchShelfMushroom",
          "target": true
        }
      },
      "probability": 0.09
    }
  ],
  "foliage_placer": {
    "type": "minecraft:blob_foliage_placer",
    "height": 3,
    "offset": 0,
    "radius": 2
  },
  "foliage_provider": {
    "type": "minecraft:simple_state_provider",
    "state": "minecraft:birch_leaves"
  },
  "ignore_vines": true,
  "minimum_size": {
    "type": "minecraft:two_layers_feature_size"
  },
  "trunk_placer": {
    "type": "wilderwild:straight_with_branches_trunk_placer",
    "base_height": 8,
    "height_rand_a": 5,
    "height_rand_b": 4,
    "trunk_branch_placement": {
      "branch_cutoff_from_top": {
        "type": "minecraft:uniform",
        "max_inclusive": 3,
        "min_inclusive": 1
      },
      "branch_length": 1,
      "branch_placement_chance": 0.15,
      "max_branch_count": {
        "type": "minecraft:uniform",
        "max_inclusive": 2,
        "min_inclusive": 1
      }
    }
  },
  "trunk_provider": {
    "type": "minecraft:simple_state_provider",
    "state": "minecraft:birch_log"
  }
}