{
  "type": "minecraft:tree",
  "below_trunk_provider": {
    "type": "minecraft:rule_based_state_provider",
    "rules": [
      {
        "if_true": {
          "type": "minecraft:not",
          "predicate": {
            "type": "minecraft:matching_block_tag",
            "tag": "minecraft:cannot_replace_below_tree_trunk"
          }
        },
        "then": {
          "type": "minecraft:simple_state_provider",
          "state": "minecraft:dirt"
        }
      }
    ]
  },
  "decorators": [
    {
      "type": "frozenlib:probability",
      "decorator": {
        "type": "frozenlib:config_predicate",
        "decorator": {
          "type": "minecraft:shelf_mushroom",
          "probability": 0.25
        },
        "predicate": {
          "type": "frozenlib:equal_to",
          "entry": "wilderwild:worldgen/treeGeneration/oakShelfMushroom",
          "target": true
        }
      },
      "probability": 0.03
    },
    {
      "type": "wilderwild:height_based_vine",
      "max_height": 260,
      "placement_chance": 0.25,
      "probability": 0.12
    }
  ],
  "foliage_placer": {
    "type": "minecraft:random_spread_foliage_placer",
    "foliage_height": 2,
    "leaf_placement_attempts": 1,
    "offset": 2,
    "radius": 2
  },
  "foliage_provider": {
    "type": "minecraft:simple_state_provider",
    "state": "minecraft:oak_leaves"
  },
  "ignore_vines": true,
  "minimum_size": {
    "type": "minecraft:two_layers_feature_size",
    "limit": 0,
    "min_clipped_height": 5,
    "upper_size": 0
  },
  "trunk_placer": {
    "type": "minecraft:upwards_branching_trunk_placer",
    "base_height": 7,
    "can_grow_through": "#minecraft:mangrove_logs_can_grow_through",
    "extra_branch_length": {
      "type": "minecraft:uniform",
      "max_inclusive": 5,
      "min_inclusive": 2
    },
    "extra_branch_steps": {
      "type": "minecraft:uniform",
      "max_inclusive": 4,
      "min_inclusive": 2
    },
    "height_rand_a": 3,
    "height_rand_b": 1,
    "place_branch_per_log_probability": 0.3
  },
  "trunk_provider": {
    "type": "minecraft:simple_state_provider",
    "state": "minecraft:oak_log"
  }
}