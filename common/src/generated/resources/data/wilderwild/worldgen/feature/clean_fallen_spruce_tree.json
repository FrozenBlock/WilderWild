{
  "type": "minecraft:tree",
  "below_trunk_provider": {
    "type": "minecraft:rule_based_state_provider",
    "rules": [
      {
        "if_true": {
          "type": "minecraft:not",
          "predicate": {
            "type": "minecraft:matching_block_tag",
            "tag": "minecraft:cannot_replace_below_tree_trunk"
          }
        },
        "then": {
          "type": "minecraft:simple_state_provider",
          "state": "minecraft:dirt"
        }
      }
    ]
  },
  "decorators": [
    {
      "type": "frozenlib:probability",
      "decorator": {
        "type": "minecraft:attached_to_logs",
        "block_provider": {
          "type": "minecraft:simple_state_provider",
          "state": "minecraft:brown_mushroom"
        },
        "directions": [
          "up"
        ],
        "probability": 0.25
      },
      "probability": 0.75
    }
  ],
  "foliage_placer": {
    "type": "wilderwild:no_op_foliage_placer"
  },
  "foliage_provider": {
    "type": "minecraft:simple_state_provider",
    "state": "minecraft:air"
  },
  "ignore_vines": true,
  "minimum_size": {
    "type": "minecraft:two_layers_feature_size"
  },
  "trunk_placer": {
    "type": "wilderwild:fallen_with_branches_trunk_placer",
    "base_height": 5,
    "branch_placement": {
      "length": 1,
      "max_count": {
        "type": "minecraft:uniform",
        "max_inclusive": 2,
        "min_inclusive": 1
      },
      "probability": 0.0
    },
    "height_rand_a": 1,
    "height_rand_b": 2,
    "hollow_probability": 0.075,
    "hollow_state": {
      "type": "minecraft:simple_state_provider",
      "state": "wilderwild:hollowed_spruce_log"
    },
    "stump_probability": 0.6,
    "water_success_probability": 0.8
  },
  "trunk_provider": {
    "type": "minecraft:simple_state_provider",
    "state": "minecraft:spruce_log"
  }
}